generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model Organization {
  id                     BigInt                    @id @default(autoincrement())
  name                   String                    @db.Citext
  email                  String                    @unique @db.Citext
  phone                  String?
  streetAddress          String?
  city                   String?
  state                  String?
  zipCode                String?
  country                String?
  taxId                  String?
  logoUrl                String?
  isActive               Boolean                   @default(true)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  expenses               ExpenseBill[]
  invoices               InvoiceBill[]
  kpis                   KpiSnapshot[]
  users                  User[]
  userInvitations        UserInvitation[]
  clients                Client[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      InvoiceCustomFieldValue[]
  customUnitsInvoice     String[]                  @default([])
  activeUnitsInvoice     String[]                  @default([])

  @@map("organizations")
}

model User {
  id                     BigInt        @id @default(autoincrement())
  orgId                  BigInt
  userType               String
  email                  String        @unique @db.Citext
  name                   String        @db.Citext
  phone                  String?
  address                String?
  passwordHash           String?
  profilePhotoKey        String?
  authProvider           AuthProvider  @default(LOCAL)
  googleId               String?       @unique
  linkedinId             String?       @unique
  role                   Role          @default(SME_USER)
  isOrgOwner             Boolean       @default(false)
  permissions            Json?
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  resetPasswordExpiresAt DateTime?
  resetPasswordToken     String?
  isEmailVerified        Boolean       @default(false)
  widgets                String[]
  caBookings             CABooking[]
  caProfile              CAProfile?
  caReviews              CAReview[]
  expenses               ExpenseBill[]
  invoices               InvoiceBill[]
  organization           Organization  @relation(fields: [orgId], references: [id])

  @@map("users")
}

model UserInvitation {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  email          String       @unique
  token          String       @unique
  permissions    Json
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("user_invitations")
}

model CustomFieldDefinition {
  id           BigInt                    @id @default(autoincrement())
  orgId        BigInt?
  name         String
  predefinedValues String[]              @default([])
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  organization Organization?             @relation(fields: [orgId], references: [id])
  values       InvoiceCustomFieldValue[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("custom_field_definitions")
}

model Client {
  id            BigInt        @id @default(autoincrement())
  orgId         BigInt?
  name          String        @db.Citext
  email         String?       @db.Citext
  phone         String?
  streetAddress String?
  city          String?
  state         String?
  zipCode       String?
  // gstin         String?
  country       String?
  companyType   String?
  taxId         String?
  taxSystem     TaxSystem     @default(NONE)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  organization  Organization?  @relation(fields: [orgId], references: [id])
  invoices      InvoiceBill[]

  @@index([orgId])
  @@map("clients")
}

model InvoiceBill {
  id                   BigInt                    @id @default(autoincrement())
  orgId                BigInt
  clientId             BigInt?
  customerId           BigInt
  invoiceNumber        String
  invoiceType          String                    @default("TAX")
  issueDate            DateTime
  dueDate              DateTime
  paymentTerms         String?
  currency             String                    @default("USD")
  exchangeRate         Decimal?                  @db.Decimal(10, 4)
  baseCurrency         String?                   @default("INR")
  baseAmount           Decimal?                  @db.Decimal(15, 2)
  subtotal             Decimal                   @default(0.00) @db.Decimal(15, 2)
  discount             Decimal                   @default(0.00) @db.Decimal(15, 2)
  taxAmount            Decimal                   @default(0.00) @db.Decimal(15, 2)
  shippingCost         Decimal                   @default(0.00) @db.Decimal(15, 2)
  totalAmount          Decimal                   @db.Decimal(15, 2)
  paidAmount           Decimal                   @default(0.00) @db.Decimal(15, 2)
  balanceDue           Decimal                   @default(0.00) @db.Decimal(15, 2)
  effectiveTax         Decimal?                  @default(0.00)
  status               String                    @default("UNPAID")
  category             String                    @default("OTHER")
  pdfKey               String?
  sentAt               DateTime?
  paidAt               DateTime?
  sellerName           String?                   @db.Citext
  sellerStreetAddress  String?
  sellerCity           String?
  sellerState          String?
  sellerZipCode        String?
  sellerCountry        String?
  sellerEmail          String?                   @db.Citext
  sellerPhone          String?
  sellerTaxId          String?
  sellerTaxSystem      String?
  iecCode              String?
  lutFiled             Boolean                   @default(false)
  taxType              String                    @default("NONE")
  placeOfSupply        String?
  reverseCharge        Boolean                   @default(false)
  reverseReason        String?
  sacCode              String?
  taxSummary           Json?
  shipToName           String?
  shipToAddress        String?
  countryOfOrigin      String?
  countryOfDestination String?
  incoterms            String?
  bankDetails          Json?
  paymentLink          String?
  bankAddress          String?
  jurisdiction         String?
  lateFeePolicy        String?
  notes                String?
  pdfStatus            String                    @default("NOT_STARTED")
  confirmedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  items                InvoiceBillItem[]
  customFields         InvoiceCustomFieldValue[]
  client               Client?                   @relation(fields: [clientId], references: [id])
  customer             User                      @relation(fields: [customerId], references: [id])
  organization         Organization              @relation(fields: [orgId], references: [id])

  @@index([clientId])
  @@map("invoice_bills")
}

model InvoiceCustomFieldValue {
  id            BigInt                @id @default(autoincrement())
  invoiceId     BigInt
  customFieldId BigInt
  orgId         BigInt
  value         String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  customField   CustomFieldDefinition @relation(fields: [customFieldId], references: [id])
  invoice       InvoiceBill           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization  Organization          @relation(fields: [orgId], references: [id])

  @@unique([invoiceId, customFieldId])
  @@index([invoiceId])
  @@index([customFieldId])
  @@index([orgId])
  @@map("invoice_custom_field_values")
}

model InvoiceBillItem {
  id          BigInt      @id @default(autoincrement())
  invoiceId   BigInt
  itemName    String
  description String?
  quantity    Decimal     @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal     @db.Decimal(15, 2)
  taxRate     Decimal     @default(0.00) @db.Decimal(15, 2)
  totalPrice  Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  unitType    String?     @default("UNIT")
  invoice     InvoiceBill @relation(fields: [invoiceId], references: [id])

  @@map("invoice_bill_items")
}

model ExpenseBill {
  id            BigInt            @id @default(autoincrement())
  orgId         BigInt
  userId        BigInt?
  merchant      String?
  expenseDate   DateTime
  totalAmount   Decimal           @db.Decimal(15, 2)
  category      String            @default("OTHER")
  paymentMethod String?
  receiptUrl    String?
  ocrExtracted  Boolean           @default(false)
  ocrConfidence Decimal?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  totalTax      Decimal?          @default(0.00) @db.Decimal(15, 2)
  items         ExpenseBillItem[]
  organization  Organization      @relation(fields: [orgId], references: [id])
  user          User?             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@map("expense_bills")
}

model ExpenseBillItem {
  id         BigInt      @id @default(autoincrement())
  expenseId  BigInt
  itemName   String?
  quantity   Decimal     @default(1) @db.Decimal(15, 2)
  unitPrice  Decimal     @db.Decimal(15, 2)
  totalPrice Decimal     @db.Decimal(15, 2)
  createdAt  DateTime    @default(now())
  taxRate    Decimal     @default(0.00) @db.Decimal(15, 2)
  unitType   String?     @default("UNIT")
  expense    ExpenseBill @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_bill_items")
}

model KpiSnapshot {
  id                     BigInt       @id @default(autoincrement())
  orgId                  BigInt
  snapshotDate           DateTime
  totalIncome            Decimal      @default(0.00) @db.Decimal(15, 2)
  totalExpenses          Decimal      @default(0.00) @db.Decimal(15, 2)
  netCashflow            Decimal      @default(0.00) @db.Decimal(15, 2)
  outstandingReceivables Decimal      @default(0.00) @db.Decimal(15, 2)
  overdueInvoicesCount   Int          @default(0)
  topExpenseCategory     String?
  expenseGrowthPercent   Decimal?     @db.Decimal(15, 2)
  createdAt              DateTime     @default(now())
  organization           Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, snapshotDate])
  @@map("kpi_snapshots")
}

model CAProfile {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @unique
  registrationNo  String?       @unique
  experienceYears Int?
  hourlyFee       Decimal?      @db.Decimal(10, 2)
  taxPercent      Decimal?      @db.Decimal(10, 2)
  bio             String?
  languages       String[]
  specializations String[]
  type            String?
  calendlyUrl     String?
  calComUrl       String?
  zoomEmail       String?       @db.Citext
  whatsappNumber  String?
  status          CAStatus      @default(PENDING)
  comment         String?
  ratingAvg       Decimal?      @db.Decimal(3, 2)
  ratingCount     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  city            String?
  country         String?
  state           String?
  streetAddress   String?
  zipCode         String?
  analytics       CAAnalytics[]
  bookings        CABooking[]
  documents       CADocument[]
  user            User          @relation(fields: [userId], references: [id])
  reviews         CAReview[]
  slots           CASlot[]

  googleCalendarConnected Boolean   @default(false)
  googleAccessToken       String?
  googleRefreshToken      String?
  googleTokenExpiry       DateTime?
  googleCalendarEmail     String?

  pendingProfile CAProfilePending? @relation("CAProfileToPending")

  @@map("ca_profiles")
}

model CADocument {
  id          BigInt         @id @default(autoincrement())
  caProfileId BigInt
  type        CADocumentType
  fileKey     String         @unique
  createdAt   DateTime       @default(now())
  description String?
  mimeType    String?
  caProfile   CAProfile      @relation(fields: [caProfileId], references: [id])

  @@map("ca_documents")
}

model CABooking {
  id          BigInt @id @default(autoincrement())
  bookingCode String @unique

  userId      BigInt
  caProfileId BigInt
  slotId      BigInt

  bookingDate DateTime @db.Date // ✅ only date (normalized)

  startTime String // ✅ snapshot from slot
  endTime   String // ✅ snapshot from slot

  consultationMode ConsultationMode
  durationMinutes  Int              @default(60)

  meetingLink     String?
  meetingProvider String?

  amount     Decimal @db.Decimal(15, 2)
  taxPercent Decimal @db.Decimal(15, 2)
  currency   String  @default("INR")

  status    BookingStatus @default(INITIATED)
  expiresAt DateTime? //temporarily block the slot for this user
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  caProfile CAProfile @relation(fields: [caProfileId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  slot      CASlot    @relation(fields: [slotId], references: [id])

  payment CAPayment?
  review  CAReview?

  @@unique([slotId, bookingDate])
  @@index([userId])
  @@index([caProfileId])
  @@map("ca_bookings")
}

model CAProfilePending {
  id          BigInt @id @default(autoincrement())
  caProfileId BigInt @unique

  registrationNo  String?
  experienceYears Int?
  hourlyFee       Decimal? @db.Decimal(10, 2)
  bio             String?
  languages       String[]
  specializations String[]
  type            String?
  calendlyUrl     String?
  calComUrl       String?
  zoomEmail       String?  @db.Citext
  whatsappNumber  String?

  city          String?
  country       String?
  state         String?
  streetAddress String?
  zipCode       String?

  status  CAPendingStatus @default(UNDER_REVIEW)
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caProfile CAProfile           @relation("CAProfileToPending", fields: [caProfileId], references: [id], onDelete: Cascade)
  documents CADocumentPending[]

  @@map("ca_profiles_pending")
}

model CADocumentPending {
  id          BigInt            @id @default(autoincrement())
  pendingId   BigInt
  type        CADocumentType
  fileKey     String            @unique
  mimeType    String?
  description String?
  operation   DocumentOperation @default(ADD)

  createdAt DateTime @default(now())

  pendingProfile CAProfilePending @relation(fields: [pendingId], references: [id])

  @@map("ca_documents_pending")
}

enum DocumentOperation {
  ADD
  DELETE
  UPDATE
}

model CAPayment {
  id               BigInt        @id @default(autoincrement())
  bookingId        BigInt        @unique
  gateway          String
  gatewayOrderId   String?
  gatewayPaymentId String?
  amount           Decimal       @db.Decimal(15, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          CABooking     @relation(fields: [bookingId], references: [id])

  @@map("ca_payments")
}

model CAReview {
  id          BigInt    @id @default(autoincrement())
  bookingId   BigInt    @unique
  caProfileId BigInt
  userId      BigInt
  rating      Int
  comment     String?
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  booking     CABooking @relation(fields: [bookingId], references: [id])
  caProfile   CAProfile @relation(fields: [caProfileId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([caProfileId])
  @@map("ca_reviews")
}

model CAAnalytics {
  id            BigInt    @id @default(autoincrement())
  caProfileId   BigInt
  snapshotDate  DateTime
  profileViews  Int       @default(0)
  bookingsCount Int       @default(0)
  earnings      Decimal   @db.Decimal(15, 2)
  caProfile     CAProfile @relation(fields: [caProfileId], references: [id])

  @@unique([caProfileId, snapshotDate])
  @@map("ca_analytics_snapshots")
}

model CASlot {
  id          BigInt           @id @default(autoincrement())
  caProfileId BigInt
  day         WeekDay          @default(MONDAY)
  typeOfCall  CASlotTypeOfCall @default(BOTH)
  startTime   String?
  endTime     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caProfile CAProfile   @relation(fields: [caProfileId], references: [id])
  bookings  CABooking[] // ✅ one-to-many

  @@index([caProfileId, day])
  @@map("ca_slots")
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
  @@ignore
}

model checkpoint_migrations {
  v Int @id

  @@ignore
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
  @@ignore
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
  @@ignore
}

enum CADocumentType {
  CERTIFICATION
  ID_PROOF
}

enum CASlotTypeOfCall {
  BOTH
  PHONE
  VIDEO
}

enum CABOOKINGTypeOfCall {
  PHONE
  VIDEO
}

enum AuthProvider {
  LOCAL
  GOOGLE
  LINKEDIN
  APPLE
}

enum UserType {
  INTERNAL
  EXTERNAL
  ADMIN
}

enum Role {
  ADMIN
  SME_USER
  CA_USER
}

enum TaxSystem {
  GST
  VAT
  SALES
  NONE
}

enum CAStatus {
  PENDING // Initial status when a CA profile is created but not yet submitted by CA for approval (Occurrs only once in the lifecycle of a CA profile)
  UNDER_REVIEW // When the CA profile is under review for the first time after being submitted for approval by CA (Occurs only once in the lifecycle of a CA profile)
  APPROVED // When the CA profile is approved and active
  REJECTED // When the CA profile is rejected after being submitted for approval by CA initially
  SUSPENDED // When the CA profile is temporarily suspended due to issues or violations
}

enum CAPendingStatus {
  PENDING // Initial status when updations are done in currently approved CA profile and not yet submitted by CA for approval 
  UNDER_REVIEW // When the updations have been submitted for approval by CA 
  REJECTED // When the updations are rejected and currently active CA profile remains unchanged
}

enum ConsultationMode {
  VIDEO
  PHONE
}

enum BookingStatus {
  INITIATED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum SlotStatus {
  AVAILABLE
  HOLD
  BOOKED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
