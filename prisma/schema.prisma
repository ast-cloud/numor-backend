generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model Organization {
  id                     BigInt                    @id @default(autoincrement())
  name                   String                    @db.Citext
  email                  String                    @unique @db.Citext
  phone                  String?
  streetAddress          String?
  city                   String?
  state                  String?
  zipCode                String?
  country                String?
  taxId                  String?
  logoUrl                String?
  isActive               Boolean                   @default(true)
  expenses               ExpenseBill[]
  invoices               InvoiceBill[]
  kpis                   KpiSnapshot[]
  users                  User[]
  userInvitations        UserInvitation[]
  clients                Client[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      InvoiceCustomFieldValue[]
  customUnitsInvoice     String[]                  @default([])
  activeUnitsInvoice     String[]                  @default([])
  paymentAccounts        PaymentAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model User {
  id                     BigInt        @id @default(autoincrement())
  orgId                  BigInt
  userType               String
  email                  String        @unique @db.Citext
  name                   String        @db.Citext
  phone                  String?
  address                String?
  passwordHash           String?
  profilePhotoKey        String?
  authProvider           AuthProvider  @default(LOCAL)
  googleId               String?       @unique
  linkedinId             String?       @unique
  role                   Role          @default(SME_USER)
  isOrgOwner             Boolean       @default(false)
  permissions            Json?
  isActive               Boolean       @default(true)
  resetPasswordExpiresAt DateTime?
  resetPasswordToken     String?
  isEmailVerified        Boolean       @default(false)
  widgets                String[]
  caBookings             CABooking[]
  caProfile              CAProfile?
  caReviews              CAReview[]
  invoicesCreated        InvoiceBill[] @relation("InvoiceCreatedBy")
  invoicesUpdated        InvoiceBill[] @relation("InvoiceUpdatedBy")
  expensesCreated        ExpenseBill[] @relation("ExpenseCreatedBy")
  expensesUpdated        ExpenseBill[] @relation("ExpenseUpdatedBy")
  organization           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserInvitation {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  email          String       @unique
  token          String       @unique
  permissions    Json
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("user_invitations")
}

model CustomFieldDefinition {
  id               BigInt   @id @default(autoincrement())
  orgId            BigInt
  name             String
  predefinedValues String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  values       InvoiceCustomFieldValue[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("custom_field_definitions")
}

model PaymentAccount {
  id       BigInt @id @default(autoincrement())
  orgId    BigInt
  // What the user picks from in the invoice dialog, e.g. "HDFC Current".
  nickname String

  bankName      String?
  accountName   String?
  // IBAN outside India, plain account number within it. One column either way,
  // because an invoice only ever prints one of the two.
  accountNumber String?
  ifsc          String?
  swift         String?
  bankAddress   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, nickname])
  @@index([orgId])
  @@map("payment_accounts")
}

model Client {
  id            BigInt        @id @default(autoincrement())
  orgId         BigInt
  name          String        @db.Citext
  email         String?       @db.Citext
  phone         String?
  streetAddress String?
  city          String?
  state         String?
  zipCode       String?
  // gstin         String?
  country       String?
  companyType   String?
  taxId         String?
  taxSystem     TaxSystem     @default(NONE)
  // Soft delete. A hard delete took the invoices with it: invoice_bills.clientId
  // is ON DELETE SET NULL, so removing a client silently wiped it from every
  // invoice that ever billed them. Every query here filters deletedAt: null.
  deletedAt     DateTime?
  // The user who deleted it. A plain audit stamp, deliberately not a relation:
  // it must survive that user being removed.
  deletedBy     BigInt?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices      InvoiceBill[]

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@map("clients")
}

model InvoiceBill {
  id                  BigInt        @id @default(autoincrement())
  orgId               BigInt
  clientId            BigInt?
  invoiceNumber       String
  invoiceType         String        @default("TAX")
  issueDate           DateTime
  dueDate             DateTime
  paymentTerms        String?
  currency            String        @default("USD")
  exchangeRate        Decimal?      @db.Decimal(10, 4)
  baseCurrency        String?       @default("INR")
  baseAmount          Decimal?      @db.Decimal(15, 2)
  subtotal            Decimal       @default(0.00) @db.Decimal(15, 2)
  discount            Decimal       @default(0.00) @db.Decimal(15, 2)
  taxAmount           Decimal       @default(0.00) @db.Decimal(15, 2)
  shippingCost        Decimal       @default(0.00) @db.Decimal(15, 2)
  totalAmount         Decimal       @db.Decimal(15, 2)
  paidAmount          Decimal       @default(0.00) @db.Decimal(15, 2)
  balanceDue          Decimal       @default(0.00) @db.Decimal(15, 2)
  effectiveTax        Decimal?      @default(0.00)
  status              InvoiceStatus @default(UNPAID)
  category            String        @default("OTHER")
  pdfKey              String?
  sentAt              DateTime?
  paidAt              DateTime?
  sellerName          String?       @db.Citext
  sellerStreetAddress String?
  sellerCity          String?
  sellerState         String?
  sellerZipCode       String?
  sellerCountry       String?
  sellerEmail         String?       @db.Citext
  sellerPhone         String?
  sellerTaxId         String?
  sellerTaxSystem     String?

  // The billed party, copied onto the invoice the way the seller already is.
  // clientId is only a pointer: deleting a client nulls it, and editing one
  // would rewrite every invoice it was ever on. These hold what was actually
  // billed, and are what the PDF and the API prefer.
  clientName           String?     @db.Citext
  clientEmail          String?     @db.Citext
  clientPhone          String?
  clientStreetAddress  String?
  clientCity           String?
  clientState          String?
  clientZipCode        String?
  clientCountry        String?
  clientTaxId          String?
  clientTaxSystem      String?
  clientCompanyType    String?
  iecCode              String?
  lutFiled             Boolean     @default(false)
  taxType              String      @default("NONE")
  placeOfSupply        String?
  reverseCharge        Boolean     @default(false)
  reverseReason        String?
  sacCode              String?
  taxSummary           Json?
  shipToName           String?
  shipToAddress        String?
  countryOfOrigin      String?
  countryOfDestination String?
  incoterms            String?
  bankDetails          Json?
  paymentLink          String?
  bankAddress          String?
  jurisdiction         String?
  lateFeePolicy        String?
  notes                String?
  // Supplied by the client, one per invoice dialog and reused on every retry.
  // It is the only thing that lets a retry re-identify its own request when the
  // response to the original never arrived - without it that retry creates a
  // second invoice. Scoped to the org so one tenant's key can never resolve to
  // another tenant's invoice.
  idempotencyKey       String?
  pdfStatus            PdfStatus   @default(NOT_STARTED)
  // Crash-safety for PDF generation. A worker claims a job by setting
  // pdfLeaseExpiresAt; if it dies, the lease expires and the sweeper hands the
  // row back instead of leaving it stuck in PROCESSING forever.
  pdfLeaseExpiresAt    DateTime?
  pdfAttempts          Int         @default(0)
  // Set before the email is sent, so a redelivered job can never send a second
  // copy to the client.
  emailSentAt          DateTime?
  // Whether the user asked for this invoice to be emailed. Persisted rather than
  // carried in the job payload, so a retry - from the row, the sweeper, anywhere
  // - cannot silently drop the intent.
  emailRequested       Boolean     @default(false)
  emailStatus          EmailStatus @default(NOT_REQUESTED)
  emailError           String?
  confirmedAt          DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById BigInt?
  updatedById BigInt?

  items        InvoiceBillItem[]
  customFields InvoiceCustomFieldValue[]
  client       Client?                   @relation(fields: [clientId], references: [id])
  createdBy    User?                     @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                     @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([clientId])
  @@index([createdById, issueDate])
  @@map("invoice_bills")
}

model InvoiceCustomFieldValue {
  id            BigInt  @id @default(autoincrement())
  orgId         BigInt
  invoiceId     BigInt
  // The definition this came from, while one still exists. Deleting a
  // definition nulls this rather than cascading the row away.
  customFieldId BigInt?
  // The field name as it stood when the invoice was written. Definitions get
  // renamed and deleted; an issued invoice keeps what it was issued with.
  name          String?
  value         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customField  CustomFieldDefinition? @relation(fields: [customFieldId], references: [id], onDelete: SetNull)
  invoice      InvoiceBill            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, customFieldId])
  @@index([invoiceId])
  @@index([customFieldId])
  @@index([orgId])
  @@map("invoice_custom_field_values")
}

model InvoiceBillItem {
  id          BigInt      @id @default(autoincrement())
  invoiceId   BigInt
  itemName    String
  description String?
  quantity    Decimal     @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal     @db.Decimal(15, 2)
  taxRate     Decimal     @default(0.00) @db.Decimal(15, 2)
  totalPrice  Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  unitType    String?     @default("UNIT")
  invoice     InvoiceBill @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_bill_items")
}

model ExpenseBill {
  id            BigInt            @id @default(autoincrement())
  orgId         BigInt
  createdById   BigInt?
  updatedById   BigInt?
  merchant      String?
  expenseDate   DateTime
  totalAmount   Decimal           @db.Decimal(15, 2)
  category      String            @default("OTHER")
  paymentMethod String?
  receiptUrl    String?
  ocrExtracted  Boolean           @default(false)
  ocrConfidence Decimal?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  totalTax      Decimal?          @default(0.00) @db.Decimal(15, 2)
  items         ExpenseBillItem[]
  organization  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?             @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([orgId])
  @@map("expense_bills")
}

model ExpenseBillItem {
  id         BigInt      @id @default(autoincrement())
  expenseId  BigInt
  itemName   String?
  quantity   Decimal     @default(1) @db.Decimal(15, 2)
  unitPrice  Decimal     @db.Decimal(15, 2)
  totalPrice Decimal     @db.Decimal(15, 2)
  createdAt  DateTime    @default(now())
  taxRate    Decimal     @default(0.00) @db.Decimal(15, 2)
  unitType   String?     @default("UNIT")
  expense    ExpenseBill @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_bill_items")
}

model KpiSnapshot {
  id                     BigInt       @id @default(autoincrement())
  orgId                  BigInt
  snapshotDate           DateTime
  totalIncome            Decimal      @default(0.00) @db.Decimal(15, 2)
  totalExpenses          Decimal      @default(0.00) @db.Decimal(15, 2)
  netCashflow            Decimal      @default(0.00) @db.Decimal(15, 2)
  outstandingReceivables Decimal      @default(0.00) @db.Decimal(15, 2)
  overdueInvoicesCount   Int          @default(0)
  topExpenseCategory     String?
  expenseGrowthPercent   Decimal?     @db.Decimal(15, 2)
  createdAt              DateTime     @default(now())
  organization           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, snapshotDate])
  @@map("kpi_snapshots")
}

model CAProfile {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @unique
  registrationNo  String?       @unique
  experienceYears Int?
  hourlyFee       Decimal?      @db.Decimal(10, 2)
  taxPercent      Decimal?      @db.Decimal(10, 2)
  bio             String?
  languages       String[]
  specializations String[]
  type            String?
  calendlyUrl     String?
  calComUrl       String?
  zoomEmail       String?       @db.Citext
  whatsappNumber  String?
  status          CAStatus      @default(PENDING)
  comment         String?
  ratingAvg       Decimal?      @db.Decimal(3, 2)
  ratingCount     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  city            String?
  country         String?
  state           String?
  streetAddress   String?
  zipCode         String?
  analytics       CAAnalytics[]
  bookings        CABooking[]
  documents       CADocument[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews         CAReview[]
  slots           CASlot[]

  googleCalendarConnected Boolean   @default(false)
  googleAccessToken       String?
  googleRefreshToken      String?
  googleTokenExpiry       DateTime?
  googleCalendarEmail     String?

  pendingProfile CAProfilePending? @relation("CAProfileToPending")

  @@map("ca_profiles")
}

model CADocument {
  id          BigInt         @id @default(autoincrement())
  caProfileId BigInt
  type        CADocumentType
  fileKey     String         @unique
  createdAt   DateTime       @default(now())
  description String?
  mimeType    String?
  caProfile   CAProfile      @relation(fields: [caProfileId], references: [id], onDelete: Cascade)

  @@map("ca_documents")
}

model CABooking {
  id          BigInt @id @default(autoincrement())
  bookingCode String @unique

  userId      BigInt
  caProfileId BigInt
  slotId      BigInt

  bookingDate DateTime @db.Date // ✅ only date (normalized)

  startTime String // ✅ snapshot from slot
  endTime   String // ✅ snapshot from slot

  consultationMode ConsultationMode
  durationMinutes  Int              @default(60)

  meetingLink     String?
  meetingProvider String?

  amount     Decimal @db.Decimal(15, 2)
  taxPercent Decimal @db.Decimal(15, 2)
  currency   String  @default("INR")

  status    BookingStatus @default(INITIATED)
  expiresAt DateTime? //temporarily block the slot for this user
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  caProfile CAProfile @relation(fields: [caProfileId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      CASlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)

  payment CAPayment?
  review  CAReview?

  @@unique([slotId, bookingDate])
  @@index([userId])
  @@index([caProfileId])
  @@map("ca_bookings")
}

model CAProfilePending {
  id          BigInt @id @default(autoincrement())
  caProfileId BigInt @unique

  registrationNo  String?
  experienceYears Int?
  hourlyFee       Decimal? @db.Decimal(10, 2)
  bio             String?
  languages       String[]
  specializations String[]
  type            String?
  calendlyUrl     String?
  calComUrl       String?
  zoomEmail       String?  @db.Citext
  whatsappNumber  String?

  city          String?
  country       String?
  state         String?
  streetAddress String?
  zipCode       String?

  status  CAPendingStatus @default(UNDER_REVIEW)
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caProfile CAProfile           @relation("CAProfileToPending", fields: [caProfileId], references: [id], onDelete: Cascade)
  documents CADocumentPending[]

  @@map("ca_profiles_pending")
}

model CADocumentPending {
  id          BigInt            @id @default(autoincrement())
  pendingId   BigInt
  type        CADocumentType
  fileKey     String            @unique
  mimeType    String?
  description String?
  operation   DocumentOperation @default(ADD)

  createdAt DateTime @default(now())

  pendingProfile CAProfilePending @relation(fields: [pendingId], references: [id], onDelete: Cascade)

  @@map("ca_documents_pending")
}

enum DocumentOperation {
  ADD
  DELETE
  UPDATE
}

model CAPayment {
  id               BigInt        @id @default(autoincrement())
  bookingId        BigInt        @unique
  gateway          String
  gatewayOrderId   String?
  gatewayPaymentId String?
  amount           Decimal       @db.Decimal(15, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          CABooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("ca_payments")
}

model CAReview {
  id          BigInt    @id @default(autoincrement())
  bookingId   BigInt    @unique
  caProfileId BigInt
  userId      BigInt
  rating      Int
  comment     String?
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  booking     CABooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  caProfile   CAProfile @relation(fields: [caProfileId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caProfileId])
  @@map("ca_reviews")
}

model CAAnalytics {
  id            BigInt    @id @default(autoincrement())
  caProfileId   BigInt
  snapshotDate  DateTime
  profileViews  Int       @default(0)
  bookingsCount Int       @default(0)
  earnings      Decimal   @db.Decimal(15, 2)
  caProfile     CAProfile @relation(fields: [caProfileId], references: [id], onDelete: Cascade)

  @@unique([caProfileId, snapshotDate])
  @@map("ca_analytics_snapshots")
}

model CASlot {
  id          BigInt           @id @default(autoincrement())
  caProfileId BigInt
  day         WeekDay          @default(MONDAY)
  typeOfCall  CASlotTypeOfCall @default(BOTH)
  startTime   String?
  endTime     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caProfile CAProfile   @relation(fields: [caProfileId], references: [id], onDelete: Cascade)
  bookings  CABooking[] // ✅ one-to-many

  @@index([caProfileId, day])
  @@map("ca_slots")
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
  @@ignore
}

model checkpoint_migrations {
  v Int @id

  @@ignore
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
  @@ignore
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
  @@ignore
}

enum CADocumentType {
  CERTIFICATION
  ID_PROOF
}

enum CASlotTypeOfCall {
  BOTH
  PHONE
  VIDEO
}

enum CABOOKINGTypeOfCall {
  PHONE
  VIDEO
}

enum AuthProvider {
  LOCAL
  GOOGLE
  LINKEDIN
  APPLE
}

enum UserType {
  INTERNAL
  EXTERNAL
  ADMIN
}

enum Role {
  ADMIN
  SME_USER
  CA_USER
}

enum TaxSystem {
  GST
  VAT
  SALES
  NONE
}

// Payment state only. Whether the invoice has been delivered is a separate
// question, answered by the sentAt timestamp - which also records when.
enum InvoiceStatus {
  DRAFT // Saved but not issued. Never counts as revenue - see chat-rls-setup.sql
  UNPAID // Issued and awaiting payment
  PAID // Settled in full
  OVERDUE // UNPAID and past dueDate - set in bulk by markOverdueInvoices()
}

// Delivery of the invoice email. Deliberately separate from PdfStatus: a failed
// send must not cost a finished PDF, and the two are retried independently.
enum EmailStatus {
  NOT_REQUESTED // The invoice was issued without asking for an email
  PENDING // Claimed by a worker, send in progress
  SENT // Accepted by the mail provider
  FAILED // Send failed, or a worker died mid-send - safe to retry by hand
}

enum PdfStatus {
  NOT_STARTED // No PDF has been asked for - a draft, or an invoice not yet confirmed
  QUEUED // Handed to QStash, not yet picked up
  PROCESSING // A worker is generating it right now
  READY // Generated and uploaded; pdfKey is set
  FAILED // Exhausted QStash retries, or publishing the job never succeeded - safe to re-queue
}

enum CAStatus {
  PENDING // Initial status when a CA profile is created but not yet submitted by CA for approval (Occurrs only once in the lifecycle of a CA profile)
  UNDER_REVIEW // When the CA profile is under review for the first time after being submitted for approval by CA (Occurs only once in the lifecycle of a CA profile)
  APPROVED // When the CA profile is approved and active
  REJECTED // When the CA profile is rejected after being submitted for approval by CA initially
  SUSPENDED // When the CA profile is temporarily suspended due to issues or violations
}

enum CAPendingStatus {
  PENDING // Initial status when updations are done in currently approved CA profile and not yet submitted by CA for approval 
  UNDER_REVIEW // When the updations have been submitted for approval by CA 
  REJECTED // When the updations are rejected and currently active CA profile remains unchanged
}

enum ConsultationMode {
  VIDEO
  PHONE
}

enum BookingStatus {
  INITIATED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum SlotStatus {
  AVAILABLE
  HOLD
  BOOKED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
